# Copy to .env and fill in. Never commit .env.

# --- Telegram ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot (get yours from @userinfobot)
ALLOWED_USER_IDS=

# --- Owner (used by the seed script and the test email) ---
OWNER_NAME=Owner
OWNER_EMAIL=you@example.com
DEFAULT_TIMEZONE=Asia/Tehran

# --- Resend ---
RESEND_API_KEY=
# Must be an address on a domain verified in Resend (or onboarding@resend.dev for tests)
EMAIL_FROM=Assistant <onboarding@resend.dev>
# Optional public HTTPS URL to a Vazir font file (no credentials or query string).
# Leave empty for Tahoma/Arial fallbacks; many email clients block remote fonts.
EMAIL_FONT_URL=

# --- DeepSeek (OpenAI-compatible API) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_S=30
DEEPSEEK_MAX_RETRIES=3

# --- Google Calendar (run `python google_auth.py` once to get the refresh token; see README) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Speech to text ---
# The Persian Vosk model is baked into the image at this path
STT_MODEL_PATH=/opt/vosk/model
# Transcripts below this mean word confidence (0..1) make the bot ask the user to repeat
STT_MIN_CONFIDENCE=0.5

# --- PostgreSQL ---
POSTGRES_USER=assistant
# Any value; special characters are fine, the connection URL is built safely
POSTGRES_PASSWORD=change-me
POSTGRES_DB=assistant
# "db" inside Docker Compose; use localhost when running outside Docker
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- App ---
# Where voice files are stored until transcribed (a volume in Docker)
AUDIO_DIR=/data/audio
LOG_LEVEL=INFO

# Host port for the API (bound to 127.0.0.1 only)
API_PORT=8000

# --- API / hardening ---
# Required for the admin endpoints (header X-Admin-Key); generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
# true exposes /docs and /openapi.json; keep false in production
DEBUG=false
# Voice messages longer than this are refused
MAX_VOICE_SECONDS=60
# Messages per minute per Telegram user
RATE_LIMIT_PER_MINUTE=10
# Leftover audio files older than this many seconds are deleted
AUDIO_MAX_AGE_S=3600
# Optional proxy for api.telegram.org, e.g. http://user:pass@host:3128 or socks5://host:1080
TELEGRAM_PROXY_URL=
# MCP server (HTTP transport, bound to 127.0.0.1)
MCP_PORT=8765

# --- Token budgets (prompt+completion tokens; 0 = no limit). "Today" = Asia/Tehran day, "month" = Jalali month ---
DAILY_TOKEN_BUDGET=0
MONTHLY_TOKEN_BUDGET=0
# true: the bot refuses new requests once a budget reaches 100% (a Telegram alert is sent at 80% and 100% either way)
BUDGET_HARD_STOP=false
# Optional: USD per 1M tokens per model, as JSON, e.g. {"deepseek-chat": {"input_miss": 0.3, "input_hit": 0.006, "output": 1.2}, "*": {...}}
# LLM_PRICES_JSON=

# --- Dashboard (usage and quality) ---
# Password for the read-only database role the dashboard uses (created automatically at start-up)
DASHBOARD_DB_PASSWORD=
DASHBOARD_DB_USER=dashboard_ro
# Run: docker compose run --rm bot python -m app.dashboard.hashpw   and paste the line it prints
DASHBOARD_PASSWORD_HASH=
# Signs the session cookie; generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
DASHBOARD_SECRET_KEY=
# Local port (127.0.0.1 only) and, in production, the public host name served by Caddy
DASHBOARD_PORT=8080
DASHBOARD_HOST=usage.example.com
# Sub-path when the dashboard lives under an existing site, e.g. /dashboard for https://example.com/dashboard
# (needs PROXY_MODE=nginx with the prefix stripped, see deploy/nginx-dashboard-subpath.conf). Empty = own host name.
DASHBOARD_BASE_PATH=
# true once the dashboard is served over HTTPS (production)
DASHBOARD_COOKIE_SECURE=false
# 1 = fill the dashboard with 30 days of demo data until real usage exists
DASHBOARD_DEMO=1

# --- Production / restricted networks (see docs/DEPLOY.md) ---
# Let's Encrypt contact for the dashboard certificate
ACME_EMAIL=you@example.com
# Optional gateway for the Telegram Bot API (a reverse proxy that forwards to api.telegram.org)
TELEGRAM_API_BASE_URL=
# Optional outbound proxy for everything else (DeepSeek, Resend, Google), honoured by httpx
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=db,dashboard,localhost,127.0.0.1

# --- Reverse proxy for the dashboard (production) ---
# caddy = the bundled Caddy serves HTTPS on 80/443 (needs those ports free)
# nginx = your existing nginx serves it and forwards to 127.0.0.1:DASHBOARD_PORT (see docs/DEPLOY.md, section 6b)
PROXY_MODE=caddy
